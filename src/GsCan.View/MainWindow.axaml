<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gscan="using:GsCan"
        xmlns:local="using:GsCan.View"
        xmlns:session="using:GsCan.View.Session"
        xmlns:sys="using:System"
        x:Class="GsCan.View.MainWindow"
        x:DataType="session:ViewSession"
        Title="{Binding WindowTitle}"
        Width="1100"
        Height="720"
        MinWidth="720"
        MinHeight="480">
    <Window.Resources>
        <local:BitrateLabelConverter x:Key="BitrateLabel" />
    </Window.Resources>
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <Border Grid.Row="0"
                Padding="12,8"
                BorderBrush="#33000000"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="设备" />
                <ComboBox Grid.Column="1"
                          MinWidth="240"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding DeviceList}"
                          PlaceholderText="无设备"
                          SelectedItem="{Binding SelectedDevice}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="gscan:DeviceInfo">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Path}" />
                                <TextBlock Text="{Binding ChannelCount, StringFormat='({0} 路通道)'}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        Command="{Binding RefreshDevices}"
                        Content="刷新" />
                <Button Grid.Column="3"
                        Margin="8,0,0,0"
                        Command="{Binding OpenSelected}"
                        Content="打开" />
                <Button Grid.Column="4"
                        Margin="8,0,0,0"
                        Command="{Binding Close}"
                        Content="关闭" />
                <TextBlock Grid.Column="5"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding OpenedPath, TargetNullValue='未打开'}" />
            </Grid>
        </Border>
        <Border Grid.Row="1"
                Padding="12,8"
                BorderBrush="#33000000"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Margin="0,0,0,8"
                           FontWeight="SemiBold"
                           Text="通道" />
                <ItemsControl ItemsSource="{Binding Channels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="session:ChannelState">
                            <Border Padding="0,6">
                                <WrapPanel>
                                    <TextBlock Margin="0,0,12,4"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="{Binding Index, StringFormat='通道 {0}'}" />
                                    <Button Margin="0,0,4,4"
                                            VerticalAlignment="Center"
                                            Command="{Binding Start}"
                                            Content="启动"
                                            IsEnabled="{Binding !IsRunning}" />
                                    <Button Margin="0,0,12,4"
                                            VerticalAlignment="Center"
                                            Command="{Binding Stop}"
                                            Content="停止" />
                                    <TextBlock Margin="0,0,4,4"
                                               VerticalAlignment="Center"
                                               Text="仲裁" />
                                    <ComboBox Width="110"
                                              Margin="0,0,12,4"
                                              VerticalAlignment="Center"
                                              ItemsSource="{x:Static session:ChannelState.ArbitrationBitrates}"
                                              SelectedItem="{Binding Bitrate}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="sys:Int32">
                                                <TextBlock Text="{Binding Converter={StaticResource BitrateLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox Margin="0,0,12,4"
                                              VerticalAlignment="Center"
                                              Content="FD"
                                              IsChecked="{Binding FdEnabled}" />
                                    <StackPanel Margin="0,0,12,4"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                IsVisible="{Binding FdEnabled}">
                                        <TextBlock VerticalAlignment="Center" Text="数据段" />
                                        <ComboBox Width="90"
                                                  VerticalAlignment="Center"
                                                  ItemsSource="{x:Static session:ChannelState.DataBitrates}"
                                                  SelectedItem="{Binding DataBitrate}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="sys:Int32">
                                                    <TextBlock Text="{Binding Converter={StaticResource BitrateLabel}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <CheckBox Margin="0,0,12,4"
                                              VerticalAlignment="Center"
                                              Content="只听"
                                              IsChecked="{Binding ListenOnly}" />
                                    <CheckBox Margin="0,0,12,4"
                                              VerticalAlignment="Center"
                                              Content="环回"
                                              IsChecked="{Binding Loopback}" />
                                    <Expander Margin="0,0,0,4"
                                              VerticalAlignment="Center"
                                              Header="更多">
                                        <CheckBox Content="OneShot" IsChecked="{Binding OneShot}" />
                                    </Expander>
                                </WrapPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Border Grid.Row="2"
                Padding="12,8"
                BorderBrush="#33000000"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Margin="0,0,12,4"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="Display Filter" />
                    <TextBlock Margin="0,0,4,4"
                               VerticalAlignment="Center"
                               Text="通道" />
                    <CheckBox Margin="0,0,4,4"
                              VerticalAlignment="Center"
                              Content="0"
                              IsChecked="{Binding DisplayFilter.ShowChannel0}" />
                    <CheckBox Margin="0,0,12,4"
                              VerticalAlignment="Center"
                              Content="1"
                              IsChecked="{Binding DisplayFilter.ShowChannel1}" />
                    <TextBlock Margin="0,0,4,4"
                               VerticalAlignment="Center"
                               Text="Kind" />
                    <CheckBox Margin="0,0,4,4"
                              VerticalAlignment="Center"
                              Content="Rx"
                              IsChecked="{Binding DisplayFilter.ShowRx}" />
                    <CheckBox Margin="0,0,4,4"
                              VerticalAlignment="Center"
                              Content="Echo"
                              IsChecked="{Binding DisplayFilter.ShowEcho}" />
                    <CheckBox Margin="0,0,12,4"
                              VerticalAlignment="Center"
                              Content="Error"
                              IsChecked="{Binding DisplayFilter.ShowError}" />
                    <CheckBox Margin="0,0,4,4"
                              VerticalAlignment="Center"
                              Content="标准"
                              IsChecked="{Binding DisplayFilter.ShowStandard}" />
                    <CheckBox Margin="0,0,12,4"
                              VerticalAlignment="Center"
                              Content="扩展"
                              IsChecked="{Binding DisplayFilter.ShowExtended}" />
                    <CheckBox Margin="0,0,4,4"
                              VerticalAlignment="Center"
                              Content="经典"
                              IsChecked="{Binding DisplayFilter.ShowClassic}" />
                    <CheckBox Margin="0,0,12,4"
                              VerticalAlignment="Center"
                              Content="FD"
                              IsChecked="{Binding DisplayFilter.ShowFd}" />
                    <CheckBox Margin="0,0,4,4"
                              VerticalAlignment="Center"
                              Content="数据"
                              IsChecked="{Binding DisplayFilter.ShowData}" />
                    <CheckBox Margin="0,0,12,4"
                              VerticalAlignment="Center"
                              Content="Remote"
                              IsChecked="{Binding DisplayFilter.ShowRemote}" />
                    <TextBlock Margin="0,0,4,4"
                               VerticalAlignment="Center"
                               Text="ID" />
                    <TextBox Width="120"
                             Margin="0,0,8,4"
                             VerticalAlignment="Center"
                             PlaceholderText="100 或 100-1FF"
                             Text="{Binding DisplayFilter.IdText}" />
                    <TextBlock Margin="0,0,0,4"
                               VerticalAlignment="Center"
                               Foreground="#B00020"
                               Text="{Binding DisplayFilter.FilterError}" />
                </WrapPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8">
                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Trace" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <CheckBox Content="暂停" IsChecked="{Binding Paused}" VerticalAlignment="Center" />
                        <Button Content="清空" Command="{Binding Clear}" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnDefinitions="80,56,56,80,36,36,36,36,36,72,44,*" Margin="4,0,20,4">
                        <TextBlock Text="相对时间" />
                        <TextBlock Grid.Column="1" Text="Channel" />
                        <TextBlock Grid.Column="2" Text="Kind" />
                        <TextBlock Grid.Column="3" Text="ID" />
                        <TextBlock Grid.Column="4" Text="Ext" />
                        <TextBlock Grid.Column="5" Text="RTR" />
                        <TextBlock Grid.Column="6" Text="FD" />
                        <TextBlock Grid.Column="7" Text="BRS" />
                        <TextBlock Grid.Column="8" Text="ESI" />
                        <TextBlock Grid.Column="9" Text="Overflow" />
                        <TextBlock Grid.Column="10" Text="长度" />
                        <TextBlock Grid.Column="11" Text="数据" />
                    </Grid>
                    <ListBox x:Name="TraceList"
                             Grid.Row="1"
                             ItemsSource="{Binding Trace}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="session:FrameRow">
                                <Grid ColumnDefinitions="80,56,56,80,36,36,36,36,36,72,44,*">
                                    <TextBlock Text="{Binding RelativeMilliseconds, StringFormat=\{0:0.###\}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Channel}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Kind}" />
                                    <TextBlock Grid.Column="3" Text="{Binding IdHex}" />
                                    <CheckBox Grid.Column="4" IsChecked="{Binding Extended, Mode=OneWay}" IsEnabled="False" />
                                    <CheckBox Grid.Column="5" IsChecked="{Binding Remote, Mode=OneWay}" IsEnabled="False" />
                                    <CheckBox Grid.Column="6" IsChecked="{Binding IsFd, Mode=OneWay}" IsEnabled="False" />
                                    <CheckBox Grid.Column="7" IsChecked="{Binding BitRateSwitch, Mode=OneWay}" IsEnabled="False" />
                                    <CheckBox Grid.Column="8" IsChecked="{Binding ErrorStateIndicator, Mode=OneWay}" IsEnabled="False" />
                                    <CheckBox Grid.Column="9" IsChecked="{Binding Overflow, Mode=OneWay}" IsEnabled="False" />
                                    <TextBlock Grid.Column="10" Text="{Binding Length}" />
                                    <TextBlock Grid.Column="11" Text="{Binding DataHex}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
        <Border Grid.Row="3"
                Padding="12,8"
                Height="220"
                BorderBrush="#33000000"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,8"
                           FontWeight="SemiBold"
                           Text="TxSlot" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnDefinitions="70,90,40,40,40,40,*,80,50,80" Margin="4,0,20,4">
                        <TextBlock Text="Channel" />
                        <TextBlock Grid.Column="1" Text="ID" />
                        <TextBlock Grid.Column="2" Text="Ext" />
                        <TextBlock Grid.Column="3" Text="RTR" />
                        <TextBlock Grid.Column="4" Text="FD" />
                        <TextBlock Grid.Column="5" Text="BRS" />
                        <TextBlock Grid.Column="6" Text="数据" />
                        <TextBlock Grid.Column="7" Text="周期 ms" />
                        <TextBlock Grid.Column="8" Text="使能" />
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding TxSlots}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="session:TxSlot">
                                <Grid ColumnDefinitions="70,90,40,40,40,40,*,80,50,80">
                                    <TextBox Text="{Binding Channel}" />
                                    <TextBox Grid.Column="1" Text="{Binding IdHex}" />
                                    <CheckBox Grid.Column="2" IsChecked="{Binding Extended}" />
                                    <CheckBox Grid.Column="3" IsChecked="{Binding Remote}" />
                                    <CheckBox Grid.Column="4" IsChecked="{Binding Fd}" />
                                    <CheckBox Grid.Column="5" IsChecked="{Binding BitRateSwitch}" />
                                    <TextBox Grid.Column="6" Text="{Binding DataHex}" />
                                    <TextBox Grid.Column="7" Text="{Binding PeriodMs}" />
                                    <CheckBox Grid.Column="8" IsChecked="{Binding Enabled}" />
                                    <Button Grid.Column="9" Content="发送" Command="{Binding Send}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
        <Border Grid.Row="4" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock FontWeight="SemiBold" Text="状态" />
                <TextBlock Text="{Binding PauseDroppedCount, StringFormat='暂停丢弃 {0}'}" />
                <TextBlock Text="{Binding LastError}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
